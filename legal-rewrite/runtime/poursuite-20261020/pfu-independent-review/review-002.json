  "findings": [
    {
      "id": "refundable-credit-restitution-distinct-pfl",
      "status": "resolved_in_002",
      "evidence": "C1 réduit A avant les crédits ; C5 maintient distinctement le crédit125-0A et ses restitutions, sans le déduire deA ni l’assimiler à une avance. Le contre-exemple donne D570,IR70,restitution1110 et soldeIR+PS1000 sur les intérêts ; ancienPFL rendu intégralement."
    },
    {
      "id": "numeric-tests-missing-final-bound",
      "status": "resolved_by_architecture_change_and_full_cash_tests",
      "evidence": "U/F et la borne contradictoire disparaissent entièrement. La réduction ne dépasse pasA par construction. Tests comprenant PFL déjà payé, crédit autonome, avances, impôt restant et restitution exécutés ; cycle complet vérifié indépendamment."
    },
    {
      "id": "divergent-social-and-ir-bases",
      "status": "resolved_for_two_explicit_approved_losses",
      "evidence": "B réintègre uniquement les pertes effectivement imputées enIR de125-00A et150-0BquinquiesIII2 quand L136-6 exclut leur imputation sociale ; A reste calculé après ces pertes. Les pertes communes restent nettes, les fractions exonérées/abattues horsB. L’exemple10k/6k donne plafond2k surB10k, pas20%duB_IR4k."
    },
    {
      "id": "fixed-abatement-test-RFR",
      "status": "resolved_in_final_frozen_tests_and_note",
      "evidence": "Le premier test algébrique utilisait RFR20k pour un gain510k/abattement500k, incompatible avec la réintégration1417IV. Le gel final a corrigé le test et la note en RFR510k et D0 ; la règle normativeC4 était et reste correcte. Vérification réaliste indépendante conforme."
    }
  ],
  "substantive_assessment": {
    "qualifying_income_and_gains": "Champ1B seulement ; produit imposable ou gain net, jamais prix de cession ni capital remboursé. Les pertes et abattements légaux restent dansA ; B ne réintègre que les deux exceptions expresses de pertes non déductibles socialement.",
    "preferential_regimes": "Taux7,5%, abattements4600/9200,40%dividendes au barème, PEA et autres exonérations, affiliations européennes et option globale rectifiable conservés ; pas de requalification en revenu taxable d’une fraction exonérée.",
