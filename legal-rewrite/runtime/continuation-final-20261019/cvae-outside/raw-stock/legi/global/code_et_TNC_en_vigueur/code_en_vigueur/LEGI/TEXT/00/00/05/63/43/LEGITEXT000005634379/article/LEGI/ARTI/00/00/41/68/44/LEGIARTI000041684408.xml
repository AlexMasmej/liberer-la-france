<th>
<br/>
			Taux applicable</th>
</tr>
<tr>
<td align="left">
<br/>
			De 0 à 6 500 €</td>
<td align="center">
<br/>
			1,258 %</td>
</tr>
<tr>
<td align="left">
<br/>
			De 6 500 € à 17 000 €</td>
<td align="center">
