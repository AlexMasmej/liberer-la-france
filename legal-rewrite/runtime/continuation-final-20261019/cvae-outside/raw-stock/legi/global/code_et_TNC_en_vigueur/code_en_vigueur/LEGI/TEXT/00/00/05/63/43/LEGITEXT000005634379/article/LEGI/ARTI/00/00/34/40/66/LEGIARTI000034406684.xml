</tr>
<tr>
<td align="center">
<br/>
			1</td>
<td align="center">
<br/>
			moins de 5 000</td>
<td align="center">
<br/>
			300</td>
</tr>
<tr>
<td align="center">
<br/>
			2</td>
<td align="center">
<br/>
