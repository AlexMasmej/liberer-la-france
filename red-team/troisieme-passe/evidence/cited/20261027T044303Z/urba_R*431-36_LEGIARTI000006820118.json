\" num=\"R*431-36\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2026-04-17\" etat=\"MODIFIE\" fin=\"2026-07-01\" id=\"LEGIARTI000053903448\" num=\"R*431-36\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2026-07-01\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000054481641\" num=\"R*431-36\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   Le dossier joint à la déclaration comprend :<br/>\n<br/>   a) Un plan permettant de connaître la situation du terrain à l'intérieur de la commune ;<br/>\n<br/>   b) Un plan de masse coté dans les trois dimensions lorsque le projet a pour effet de créer une construction ou de modifier le volume d'une construction existante ;<br/>\n<br/>   c) Une représentation de l'aspect extérieur de la construction faisant apparaître les modifications projetées et si le projet a pour effet de modifier celui-ci.<br/>\n<br/>   Il est complété, s'il y a lieu, par les documents mentionnés aux articles R. 431-14 et R. 431-15, au e de l'article R. 431-16 et aux articles R. 431-10, R. 431-21, R. 431-25, R. 431-32 et R. 431-33.<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"\" datesignatexte=\"\" id=\"\" naturetexte=\"\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"CODIFICATION\">Décret 73-1023 1973-11-08</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000817105\" datesignatexte=\"2007-01-05\" id=\"LEGIARTI000006823683\" naturetexte=\"DECRET\" nortexte=\"EQUU0601334D\" num=\"9\" numtexte=\"2007-18\" sens=\"source\" typelien=\"CREATION\">Décret n°2007-18 du 5 janvier 2007 - art. 9 () JORF 6 janvier 2007 en vigueur le 1er octobre 2007</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000246152\" datesignatexte=\"2007-05-11\" id=\"LEGIARTI000006264562\" naturetexte=\"DECRET\" nortexte=\"EQUU0752915D\" num=\"3\" numtexte=\"2007-817\" sens=\"source\" typelien=\"MODIFICATION\">Décret n°2007-817 du 11 mai 2007 - art. 3 () JORF 12 mai 2007</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000047518324\" naturetexte=\"CODE\" nortexte=\"\" num=\"A431-9\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de l'urbanisme - art. A431-9 (VD)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006820093\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*431-16\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*431-16 (MMN)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGITEXT000006074075\" naturetexte=\"CODE\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme R431-14, R431-15, R431-16, R431-10, R431-21, R431-25, R431-32, R431-33</LIEN>\n</LIENS>\n</ARTICLE>\n",
