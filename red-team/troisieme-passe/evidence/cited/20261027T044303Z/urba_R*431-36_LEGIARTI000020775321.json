signatexte=\"2999-01-01\" id=\"LEGIARTI000006820091\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*431-14\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*431-14</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006820093\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*431-16\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*431-16</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006820099\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*431-21\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*431-21</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006820105\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*431-25\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*431-25</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006820114\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*431-32\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*431-32</LIEN>\n</LIENS>\n</ARTICLE>\n",
