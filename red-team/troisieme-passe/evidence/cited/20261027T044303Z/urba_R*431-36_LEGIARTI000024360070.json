 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000024360070</ID>\n<ANCIEN_ID/>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/24/36/00/LEGIARTI000024360070.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>R*431-36</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>2011-07-14</DATE_DEBUT>\n<DATE_FIN>2012-03-01</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006074075\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code de l'urbanisme\" debut=\"1973-01-03\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006074075\">Code de l'urbanisme</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1973-01-03\" fin=\"2999-01-01\" id=\"LEGISCTA000006107993\">Partie réglementaire - Décrets en Conseil d'Etat</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2007-01-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006128597\">Livre IV : Régime applicable aux constructions, aménagements et démolitions</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2007-10-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006143424\">Titre III : Dispositions propres aux constructions</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2007-10-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006158842\">Chapitre Ier : Dispositions générales</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2007-10-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006175991\"> Section 3 : Déclaration préalable portant sur un projet de construction, sur des travaux sur une construction existante ou sur un changement de destination d'une construction</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2007-10-01\" etat=\"MODIFIE\" fin=\"2009-06-21\" id=\"LEGIARTI000006820118\" num=\"R*431-36\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2