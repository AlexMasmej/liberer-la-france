 administrative</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2008-05-01\" etat=\"MODIFIE\" fin=\"2010-02-15\" id=\"LEGIARTI000018537664\" num=\"D1233-12\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2010-02-15\" etat=\"MODIFIE\" fin=\"2013-06-29\" id=\"LEGIARTI000022356901\" num=\"D1233-12\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2013-06-29\" etat=\"MODIFIE\" fin=\"2018-01-01\" id=\"LEGIARTI000027647711\" num=\"D1233-12\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2018-01-01\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000036482984\" num=\"D1233-12\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<p>\n<br/>Le délai dont dispose le directeur départemental du travail, de l'emploi et de la formation professionnelle pour procéder aux vérifications prévues à l'article L. 1233-53 court à compter : <br/>1° Soit de la date d'envoi de la notification du projet de licenciement ; <br/>2° Soit, en cas de recours à un expert-comptable par le comité d'entreprise, du lendemain de la deuxième réunion de ce dernier prévue à l'article L. 1233-35.</p>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000018442415\" datesignatexte=\"2008-03-07\" id=\"LEGIARTI000018456736\" naturetexte=\"DECRET\" nortexte=\"MTST0804938D\" num=\"Annexe\" numtexte=\"2008-244\" sens=\"cible\" typelien=\"CREE\">Décret n°2008-244 du 7 mars 2008 - art. (V)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006901047\" naturetexte=\"CODE\" nortexte=\"\" num=\"L1233-35\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code du travail - art. L1233-35 (VD)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006901065\" naturetexte=\"CODE\" nortexte=\