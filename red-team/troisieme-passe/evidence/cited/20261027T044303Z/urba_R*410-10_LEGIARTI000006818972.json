 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000006818972</ID>\n<ANCIEN_ID>UBAXXXXXXXX2X410R10AXXAB</ANCIEN_ID>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/06/81/89/LEGIARTI000006818972.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>R*410-10</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>2007-10-01</DATE_DEBUT>\n<DATE_FIN>2016-01-01</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006074075\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code de l'urbanisme\" debut=\"1973-01-03\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006074075\">Code de l'urbanisme</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1973-01-03\" fin=\"2999-01-01\" id=\"LEGISCTA000006107993\">Partie réglementaire - Décrets en Conseil d'Etat</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2007-01-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006128597\">Livre IV : Régime applicable aux constructions, aménagements et démolitions</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2007-10-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006143463\">Titre Ier : Certificat d'urbanisme</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2007-10-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006158916\"> Section 2 : Instruction de la demande</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"ABROGE\">\n<LIEN_ART debut=\"1973-11-13\" etat=\"ABROGE\" fin=\"1984-04-01\" id=\"LEGIARTI000006818971\" num=\"R*410-10\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2007-10-01\" etat=\"MODIFIE\" fin=\"2016-01-01\" id=\"LEGIARTI000006818972\" num=\"R*410-10\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2016-01-01\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000031764615\" num=\"R*410-10\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>Dans le cas prévu au b de l'article L. 410-1, le délai d'instruction est de deux mois à compter de la réception en mairie de la demande. <br/>\n<br/>L'autorité compétente recueille l'avis des collectivités, établissements publics et services gestionnaires des réseaux mentionnés à l'article L. 111-4 ainsi que les avis prévus par les articles R. 423-52 et R. 423-53. <br/>\n<br/>Ces avis sont réputés favorables s'ils n'ont pas été émis dans le délai d'un mois à compter de la réception de la demande d'avis.<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000858487\" datesignatexte=\"1972-07-03\" id=\"JORFTEXT000000858487\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"72-613\" sens=\"source\" typelien=\"CONCORDANCE\">Décret 72-613 1972-07-03 ART. 6-4</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000817105\" datesignatexte=\"2007-01-05\" id=\"LEGIARTI000006823683\" naturetexte=\"DECRET\" nortexte=\"EQUU0601334D\" num=\"9\" numtexte=\"2007-18\" sens=\"source\" typelien=\"CREATION\">Décret n°2007-18 du 5 janvier 2007 - art. 9 () JORF 6 janvier 2007 en vigueur le 1er octobre 2007</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006814680\" naturetexte=\"CODE\" nortexte=\"\" num=\"L111-4\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. L111-4 (V)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006815652\" naturetexte=\"CODE\" nortexte=\"\" num=\"L410-1\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. L410-1 (V)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006818978\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*410-12\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de l'urbanisme - art. R*410-12 (V)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006819962\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*423-52\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*423-52 (V)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006074075\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006819963\" naturetexte=\"CODE\" nortexte=\"\" num=\"R*423-53\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de l'urbanisme - art. R*423-53 (V)</LIEN>\n<LIEN cidtexte=\"\" datesignatexte=\"\" id=\"\" naturetexte=\"\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"CODIFICATION\">Décret 73-1023 1973-11-08</LIEN>\n</LIENS>\n</ARTICLE>\n",
