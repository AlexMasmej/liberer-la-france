06747070\" num=\"R137-2\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2008-01-01\" etat=\"MODIFIE\" fin=\"2014-05-30\" id=\"LEGIARTI000017782773\" num=\"R137-2\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2014-05-30\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000029007635\" num=\"R137-2\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   A titre justificatif, les entreprises d'assurance doivent :<br/>\n<br/>   1. Conserver un exemplaire de la déclaration mentionnée à l'article R. 137-1 ;<br/>\n<br/>   2. Etablir un état récapitulatif annuel des assurés non assujettis indiquant les noms et adresses de ces assurés, les numéros des contrats souscrits par eux, les dates d'échéance et les montants des primes correspondantes.<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000866621\" datesignatexte=\"1985-12-17\" id=\"JORFTEXT000000866621\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"85-1353\" sens=\"source\" typelien=\"CODIFICATION\">Décret 85-1353 1985-12-17</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000383417\" datesignatexte=\"1997-05-31\" id=\"LEGIARTI000006771929\" naturetexte=\"DECRET\" nortexte=\"TASS9721612D\" num=\"1\" numtexte=\"97-635\" sens=\"source\" typelien=\"CREATION\">Décret n°97-635 du 31 mai 1997 - art. 1 () JORF 1er juin 1997</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000591200\" datesignatexte=\"2002-04-29\" id=\"JORFTEXT000000591200\" naturetexte=\"DECRET\" nortexte=\"MESS0221185D\" num=\"\" numtexte=\"2002-657\" sens=\"source\" typelien=\"ABROGATION\">Décret 2002-657 2002-04-29 art. 2 1° JORF 2 mai 2002</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006073189\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006747067\" naturetexte=\"CODE\" nortexte=\"\" num=\"R137-1\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code de la sécurité sociale. - art. R137-1 (Ab)</LIEN>\n<LIEN cidtexte=\"LEGITEXT00000