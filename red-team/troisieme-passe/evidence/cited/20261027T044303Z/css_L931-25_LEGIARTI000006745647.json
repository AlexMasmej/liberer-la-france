IE\" fin=\"2005-12-16\" id=\"LEGIARTI000006745644\" num=\"L931-25\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2005-12-16\" etat=\"MODIFIE\" fin=\"2006-06-24\" id=\"LEGIARTI000006745645\" num=\"L931-25\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2006-06-24\" etat=\"MODIFIE\" fin=\"2006-12-31\" id=\"LEGIARTI000006745646\" num=\"L931-25\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2006-12-31\" etat=\"MODIFIE\" fin=\"2016-01-01\" id=\"LEGIARTI000006745647\" num=\"L931-25\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2016-01-01\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000030438945\" num=\"L931-25\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   La méconnaissance des incapacités prévues à l'article L. 931-9 est punie d'un emprisonnement de trois ans et d'une amende de 75 000 euros.<br/>\n<br/>   La méconnaissance, par tout président ou dirigeant salarié d'une institution de prévoyance ou d'une union, de l'une des dispositions des articles L. 932-49 à L. 932-51 est punie de six mois d'emprisonnement et de 7 500 euros d'amende.<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000866621\" datesignatexte=\"1985-12-17\" id=\"JORFTEXT000000866621\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"85-1353\" sens=\"source\" typelien=\"CODIFICATION\">Décret 85-1353 1985-12-17</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000458333\" datesignatexte=\"2006-12-30\" id=\"LEGIARTI000006659274\" naturetexte=\"LOI\" nortexte=\"SOCX0600085L\" num=\"64\" numtexte=\"2006-1770\" sens=\"source\" typelien=\"MODIFICATION\">Loi n°2006-1770 du 30 décembre 2006 - art. 64 (V) JORF 31 décembre 2006</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006073189\" datesignatexte=\"2999-01-01\" id=\"LEGITEXT000006073189\" naturetexte=\"CODE\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"sou