 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000006903161</ID>\n<ANCIEN_ID>WXXXXXXXXXX4132L0020XX0A</ANCIEN_ID>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/06/90/31/LEGIARTI000006903161.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>L4132-2</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>2008-05-01</DATE_DEBUT>\n<DATE_FIN>2018-01-01</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006072050\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code du travail\" debut=\"1973-01-03\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006072050\">Code du travail</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006112874\">Partie législative  </TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006132338\">Quatrième partie : Santé et sécurité au travail</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006145407\">Livre Ier : Dispositions générales </TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006160775\">Titre III : Droits d'alerte et de retrait</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006178069\">Chapitre II : Conditions d'exercice des droits d'alerte et de retrait.</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2008-05-01\" etat=\"MODIFIE\" fin=\"2018-01-01\" id=\"LEGIARTI000006903161\" num=\"L4132-2\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2018-01-01\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000035653288\" num=\"L4132-2\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<C