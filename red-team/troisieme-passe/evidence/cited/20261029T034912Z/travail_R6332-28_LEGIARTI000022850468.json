01\" fin=\"2015-01-01\" id=\"LEGISCTA000018522774\">Paragraphe 2 : Disponibilités</TITRE_TM>\n<TITRE_TM debut=\"2015-01-01\" fin=\"2019-01-01\" id=\"LEGISCTA000029643313\">Paragraphe 2 : Prise en charge des demandes des employeurs</TITRE_TM>\n<TITRE_TM debut=\"2019-01-01\" fin=\"2999-01-01\" id=\"LEGISCTA000037934413\">Paragraphe 2 : Frais de gestion et d'information et frais relatifs aux missions des opérateurs de compétences</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2008-05-01\" etat=\"MODIFIE\" fin=\"2010-09-25\" id=\"LEGIARTI000018522772\" num=\"R6332-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2010-09-25\" etat=\"MODIFIE\" fin=\"2015-01-01\" id=\"LEGIARTI000022850468\" num=\"R6332-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2015-01-01\" etat=\"MODIFIE\" fin=\"2019-01-01\" id=\"LEGIARTI000029643321\" num=\"R6332-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE_MORT_NE\">\n<LIEN_ART debut=\"2019-01-01\" etat=\"MODIFIE_MORT_NE\" fin=\"2018-12-24\" id=\"LEGIARTI000037388017\" num=\"R6332-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2019-01-01\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000037934354\" num=\"R6332-28\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<p>\n<br/>Les disponibilités, dont un organisme collecteur paritaire agréé au titre de la professionnalisation et du droit individuel à la formation ou du congé individuel de formation peut disposer au 31 décembre d'une année donnée, ne peuvent excéder le tiers des charges comptabilisées au cours du dernier exercice clos.<br/>N'entrent pas dans le calcul des disponibilités les dotations aux amortissements et provisions                                           .</p>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cid