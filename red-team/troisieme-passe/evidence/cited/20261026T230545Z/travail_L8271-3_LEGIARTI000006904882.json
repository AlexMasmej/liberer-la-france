 etat=\"MODIFIE\" fin=\"2016-08-10\" id=\"LEGIARTI000024500720\" num=\"L8271-3\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"ABROGE_DIFF\">\n<LIEN_ART debut=\"2016-08-10\" etat=\"ABROGE_DIFF\" fin=\"2029-01-01\" id=\"LEGIARTI000033025016\" num=\"L8271-3\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR_DIFF\">\n<LIEN_ART debut=\"2029-01-01\" etat=\"VIGUEUR_DIFF\" fin=\"2999-01-01\" id=\"LEGIARTI000052851296\" num=\"L8271-3\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU>\n<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>\n</CONTENU>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   Lorsqu'ils ne relèvent pas des services de la police ou de la gendarmerie nationales, les agents de contrôle mentionnés à l'article L. 8271-1 peuvent solliciter des interprètes assermentés inscrits sur l'une des listes prévues à l'article 157 du code de procédure pénale, pour le contrôle de la réglementation sur la main-d'oeuvre étrangère et le détachement transnational de travailleurs.<br/>\n<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000465978\" datesignatexte=\"2007-03-12\" id=\"JORFTEXT000000465978\" naturetexte=\"ORDONNANCE\" nortexte=\"SOCX0700017R\" num=\"\" numtexte=\"2007-329\" sens=\"source\" typelien=\"CODIFICATION\">Ordonnance 2007-329 2007-03-12 JORF 13 mars 2007</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006071154\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006575365\" naturetexte=\"CODE\" nortexte=\"\" num=\"157\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">CODE DE PROCEDURE PENALE - art. 157 (M)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006648364\" naturetexte=\"CODE\" nortexte=\"\" num=\"L325-2-1\" numtexte=\"\" sens=\"cible\" typelien=\"CONCORDE\">Code du travail - art. L325-2-1 (AbD)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006648364\" naturetexte=\"CODE\" nortexte=\"\" num=\"L325-2-1\" numtexte=\"\" sens=\"