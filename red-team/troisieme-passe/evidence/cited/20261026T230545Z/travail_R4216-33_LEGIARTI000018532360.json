at=\"MODIFIE\">\n<LIEN_ART debut=\"2018-01-01\" etat=\"MODIFIE\" fin=\"2021-02-13\" id=\"LEGIARTI000036483611\" num=\"R4216-33\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"ABROGE_DIFF\">\n<LIEN_ART debut=\"2021-02-13\" etat=\"ABROGE_DIFF\" fin=\"2027-01-01\" id=\"LEGIARTI000043128583\" num=\"R4216-33\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<p>\n<br/>La dispense est accordée, après enquête de l'inspecteur du travail.<br/> Elle est accordée après avis :<br/> 1° Du comité d'hygiène, de sécurité et des conditions de travail ou, à défaut, des délégués du personnel ;<br/> 2° De la commission centrale de sécurité ou de la commission consultative départementale de sécurité et d'accessibilité pour les établissements recevant du public.</p>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000018442415\" datesignatexte=\"2008-03-07\" id=\"LEGIARTI000018456736\" naturetexte=\"DECRET\" nortexte=\"MTST0804938D\" num=\"Annexe\" numtexte=\"2008-244\" sens=\"cible\" typelien=\"CREE\">Décret n°2008-244 du 7 mars 2008 - art. (V)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000018510912\" naturetexte=\"CODE\" nortexte=\"\" num=\"R235-4-18\" numtexte=\"\" sens=\"source\" typelien=\"CONCORDANCE\">Code du travail - art. R235-4-18 al 2 (Ab)</LIEN>\n</LIENS>\n</ARTICLE>\n",
