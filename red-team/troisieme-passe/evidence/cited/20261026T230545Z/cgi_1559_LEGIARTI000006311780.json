cles et maisons de jeux</TITRE_TM>\n<TITRE_TM debut=\"2019-01-01\" fin=\"2025-01-01\" id=\"LEGISCTA000036364706\">II : Impôt sur les maisons de jeux</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1987-08-10\" fin=\"1998-04-22\" id=\"LEGISCTA000006191914\">Champ d'application.</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1950-04-30\" etat=\"MODIFIE\" fin=\"1955-07-01\" id=\"LEGIARTI000049202306\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"ABROGE\">\n<LIEN_ART debut=\"1955-07-01\" etat=\"ABROGE\" fin=\"1979-07-01\" id=\"LEGIARTI000049670357\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1979-07-01\" etat=\"MODIFIE\" fin=\"1982-01-01\" id=\"LEGIARTI000006311778\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1982-01-01\" etat=\"MODIFIE\" fin=\"1987-08-10\" id=\"LEGIARTI000006311779\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1987-08-10\" etat=\"MODIFIE\" fin=\"1998-04-22\" id=\"LEGIARTI000006311780\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1998-04-22\" etat=\"MODIFIE\" fin=\"2006-12-27\" id=\"LEGIARTI000006311781\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2006-12-27\" etat=\"MODIFIE\" fin=\"2015-01-01\" id=\"LEGIARTI000006311782\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2015-01-01\" etat=\"MODIFIE\" fin=\"2019-01-01\" id=\"LEGIARTI000030021923\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"ABROGE\">\n<LIEN_ART debut=\"2019-01-01\" etat=\"ABROGE\" fin=\"2025-01-01\" id=\"LEGIARTI000036364730\" num=\"1559\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   Les spectacles, jeux et divertissements de toute na