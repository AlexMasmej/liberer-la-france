=\"2026-06-27\" id=\"LEGIARTI000048838741\" num=\"1744\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"ABROGE_DIFF\">\n<LIEN_ART debut=\"2026-06-27\" etat=\"ABROGE_DIFF\" fin=\"2027-01-01\" id=\"LEGIARTI000054334864\" num=\"1744\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR_DIFF\">\n<LIEN_ART debut=\"2027-01-01\" etat=\"VIGUEUR_DIFF\" fin=\"2999-01-01\" id=\"LEGIARTI000054566835\" num=\"1744\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<p>Toute personne, association ou organisme qui n'a pas effectué dans les délais prescrits le versement des retenues opérées au titre de la taxe proportionnelle (art. 1669 et 1671) ou n'a effectué que des versements insuffisants est passible, si le retard excède un mois, en sus de l’amende fiscale instituée par le paragraphe 1 de l’article 1740, d’une amende pénale de 120.000 F à 1.200.000 F et d'un emprisonnement d'un an au moins et de cinq ans au plus.</p>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000496040\" datesignatexte=\"1950-04-06\" id=\"LEGIARTI000047498856\" naturetexte=\"DECRET\" nortexte=\"\" num=\"Annexe\" numtexte=\"50-478\" sens=\"source\" typelien=\"CREATION\">Décret n° 50-478 du 6 avril 1950 - art. Annexe</LIEN>\n<LIEN cidtexte=\"JORFTEXT000054309429\" datesignatexte=\"2026-06-25\" id=\"LEGIARTI000054312169\" naturetexte=\"LOI\" nortexte=\"SFHT2521808L\" num=\"80\" numtexte=\"2026-534\" sens=\"cible\" typelien=\"CITATION\">LOI n°2026-534 du 25 juin 2026 - art. 80</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006071154\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000054334730\" naturetexte=\"CODE\" nortexte=\"\" num=\"28-1\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de procédure pénale - art. 28-1 (VT)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006071154\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000048838748\" naturetexte=\"CODE\" nortexte=\"\" num=\"28-2\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de procédur