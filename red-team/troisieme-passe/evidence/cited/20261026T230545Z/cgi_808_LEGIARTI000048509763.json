 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000048509763</ID>\n<ANCIEN_ID/>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/48/50/97/LEGIARTI000048509763.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>808</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>1950-04-30</DATE_DEBUT>\n<DATE_FIN>1979-07-01</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006069577\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code général des impôts, CGI.\" debut=\"1952-02-14\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006069577\">Code général des impôts</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1959-01-09\" fin=\"1982-12-30\" id=\"LEGISCTA000006084250\">ASSIETTE ET LIQUIDATION DE L'IMPOT</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1967-12-29\" fin=\"1982-12-30\" id=\"LEGISCTA000006114499\">IMPOTS D'ETAT</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1972-08-30\" fin=\"1983-01-01\" id=\"LEGISCTA000006133871\">DROITS D'ENREGISTREMENT ET TAXE DE PUBLICITE FONCIERE</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1979-07-01\" fin=\"1983-01-01\" id=\"LEGISCTA000006147148\">LES TARIFS ET LEUR APPLICATION.</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1950-04-30\" etat=\"MODIFIE\" fin=\"1979-07-01\" id=\"LEGIARTI000048509763\" num=\"808\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1979-07-01\" etat=\"MODIFIE\" fin=\"1980-01-19\" id=\"LEGIARTI000006310449\" num=\"808\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1980-01-19\" etat=\"MODIFIE\" fin=\"2010-05-01\" id=\"LEGIARTI000006310450\" num=\"808\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2010-05-01\" etat=\"V