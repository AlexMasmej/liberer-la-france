 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000006815809</ID>\n<ANCIEN_ID>UBAXXXXXXXX1X480L05AXXAA</ANCIEN_ID>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/06/81/58/LEGIARTI000006815809.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>L480-5</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>1973-11-13</DATE_DEBUT>\n<DATE_FIN>1985-07-19</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006074075\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code de l'urbanisme\" debut=\"1973-01-03\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006074075\">Code de l'urbanisme</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1973-03-27\" fin=\"2999-01-01\" id=\"LEGISCTA000006107992\">Partie législative</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1973-11-13\" fin=\"1987-07-23\" id=\"LEGISCTA000006128565\">Règles relatives à l'acte de construire et à divers modes d'utilisation du sol</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1973-11-13\" fin=\"1985-07-19\" id=\"LEGISCTA000006143313\">Infractions.</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1973-11-13\" etat=\"MODIFIE\" fin=\"1985-07-19\" id=\"LEGIARTI000006815809\" num=\"L480-5\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1986-01-07\" etat=\"MODIFIE\" fin=\"2003-07-03\" id=\"LEGIARTI000006815810\" num=\"L480-5\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2003-07-03\" etat=\"MODIFIE\" fin=\"2007-10-01\" id=\"LEGIARTI000006815811\" num=\"L480-5\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2007-10-01\" etat=\"MODIFIE\" fin=\"2016-01-01\" id=\"LEGIARTI000006815812\" num=\"L480-5\" origine=\"LEGI\"/>\n</V