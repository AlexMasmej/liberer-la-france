lonnement de ce remboursement.<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000867981\" datesignatexte=\"1946-11-27\" id=\"LEGIARTI000006765185\" naturetexte=\"DECRET\" nortexte=\"\" num=\"182\" numtexte=\"46-2769\" sens=\"cible\" typelien=\"CITATION\">Décret n°46-2769 du 27 novembre 1946 - art. 182 (V)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000327336\" datesignatexte=\"1952-10-18\" id=\"LEGIARTI000006763742\" naturetexte=\"DECRET\" nortexte=\"\" num=\"42\" numtexte=\"52-1166\" sens=\"cible\" typelien=\"CITATION\">Décret n°52-1166 du 18 octobre 1952 - art. 42 (Ab)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000687459\" datesignatexte=\"1955-05-31\" id=\"LEGIARTI000006763652\" naturetexte=\"DECRET\" nortexte=\"\" num=\"36-2\" numtexte=\"55-753\" sens=\"cible\" typelien=\"CITATION\">Décret n°55-753 du 31 mai 1955 - art. 36-2 (Ab)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000699946\" datesignatexte=\"1977-09-26\" id=\"LEGIARTI000054473392\" naturetexte=\"ORDONNANCE\" nortexte=\"\" num=\"9-6\" numtexte=\"77-1102\" sens=\"cible\" typelien=\"CITATION\">Ordonnance n° 77-1102 du 26 septembre 1977 - art. 9-6 (V)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000866621\" datesignatexte=\"1985-12-17\" id=\"JORFTEXT000000866621\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"85-1353\" sens=\"source\" typelien=\"CODIFICATION\">Décret 85-1353 1985-12-17</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000866621\" datesignatexte=\"1985-12-17\" id=\"JORFTEXT000000866621\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"85-1353\" sens=\"source\" typelien=\"CREATION\">Décret 85-1353 1985-12-17 art. 1 JORF 21 décembre 1985</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000508819\" datesignatexte=\"1987-07-17\" id=\"LEGIARTI000044629874\" naturetexte=\"LOI\" nortexte=\"ASEX8700087L\" num=\"5\" numtexte=\"87-563\" sens=\"cible\" typelien=\"CITATION\">Loi n° 87-563 du 17 juillet 1987 - art. 5 (VD)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000717193\" datesignatexte=\"1990-12-20\" id=\"LEGIARTI00000