is A\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2020-09-13\" etat=\"MODIFIE\" fin=\"2021-11-17\" id=\"LEGIARTI000042327688\" num=\"155 bis A\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2021-11-17\" etat=\"MODIFIE\" fin=\"2022-07-27\" id=\"LEGIARTI000044329274\" num=\"155 bis A\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2022-07-27\" etat=\"MODIFIE\" fin=\"2023-09-07\" id=\"LEGIARTI000046093196\" num=\"155 bis A\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2023-09-07\" etat=\"MODIFIE\" fin=\"2024-12-06\" id=\"LEGIARTI000048046958\" num=\"155 bis A\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2024-12-06\" etat=\"MODIFIE\" fin=\"2026-03-20\" id=\"LEGIARTI000050744951\" num=\"155 bis A\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2026-03-20\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000053702677\" num=\"155 bis A\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<p>Les tarifs de la taxe minière sur l'or en Guyane applicables en 2025 sont fixés comme suit :</p>\n\n<table border=\"1\">\n<tbody>\n<tr>\n<td>\n<p align=\"center\">CATÉGORIES D'ENTREPRISES</p>\n</td>\n<td>\n<p align=\"center\">PAR KILOGRAMME</p>\n<p align=\"center\">(extrait)</p>\n<p align=\"center\">(en euros)</p>\n</td>\n</tr>\n<tr>\n<td align=\"center\">\n<p align=\"left\">Petites et moyennes entreprises</p>\n</td>\n<td align=\"center\">\n<br/>\n\t\t\t709,47</td>\n</tr>\n<tr>\n<td align=\"center\">\n<p align=\"left\">Autres entreprises</p>\n</td>\n<td align=\"center\">\n<br/>\n\t\t\t1 418,94</td>\n</tr>\n</tbody>\n</table>\n\n<p>Ces tarifs ne comprennent pas les frais d'assiette et de recouvrement, de dégrèvement et de non-valeurs perçus au profit de l'Etat en application des articles 1641 et 1644 du code général des impôts.</p>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000050730946\" datesignatexte=\"2024-11-25\" id=\"LEGITEXT000050739645\" naturetexte=\"ARRETE\" nortexte=\"ECOL2427414A\" num=\"\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Arrêté du 25 novembre 2024 (V)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000050730946\" datesignatexte=\"2024-11-25\" id=\"LEGIARTI000050739651\" naturetexte=\"ARRETE\" nortexte=\"ECOL2427414A\" num=\"1\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Arrêté du 25 novembre 2024 - art. 1</LIEN>\n\n<LIEN cidtexte=\"JORFTEXT000053700623\" datesignatexte=\"2025-12-08\" id=\"LEGIARTI000053702272\" naturetexte=\"ARRETE\" nortexte=\"ECOL2531689A\" num=\"1\" numtexte=\"\" sens=\"cible\" typelien=\"MODIFIE\">Arrêté du 8 décembre 2025 - art. 1</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006069577\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006311906\" naturetexte=\"CODE\" nortexte=\"\" num=\"1641\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code général des impôts, CGI. - art. 1641</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006069577\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006306858\" naturetexte=\"CODE\" nortexte=\"\" num=\"1644\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code général des impôts, CGI. - art. 1644</LIEN>\n</LIENS>\n</ARTICLE>\n",
 "document_sha256": "a3f1d81a7f3e834d0cc795b6c4f835ccc21cca54c7d76692da65abc7ab93ff52",
 "draft": {
  "source_sha256": "a3f1d81a7f3e834d0cc795b6c4f835ccc21cca54c7d76692da65abc7ab93ff52",
  "status": "retained_unchanged",
  "proposed_xml": null,
  "proposed_sha256": null,
  "reason": "Maintien intégral du barème millésimé 2025, après examen des tarifs et frais : il sert aux liquidations et réclamations de cette année et préserve le tarif PME égal à la moitié de celui des autres entreprises. Une abrogation prospective de ce seul tableau ancien ne supprimerait aucun tarif futur ; le faire passer pour une coupe serait fictif. Aucun tarif intermédiaire ni remise rétroactive générale n'est décidé. Le brouillon stylistique est écarté.",
  "reason_sha256": "44b2cbcdc17e1805fd827e85e96a976e16e813c06987be70e2b0b5d262639acd",
  "review_notes": "Tableau intégral vérifié : 709,47 euros et 1 418,94 euros par kilogramme extrait, hors frais des articles 1641 et 1644. CGI 1599 quinquies B lu en entier : assiette sur masse nette extraite l'année précédente, tarifs bornés, déduction environnementale plafonnée à 45 % et 5 000 euros. Ces avantages restent ouverts dans leur régime propre. Incohérence chronologique préexistante : source portant 2025, métadonnée valid_from au 20 mars 2026 ; aucun millésime corrigé implicitement. Les taux de frais 1641/1644 ne sont pas vérifiés ni modifiés dans ce lot.",
  "review_notes_sha256": "f77555d92a5422483570c52bd8744fd7a5ea23b6f2d1e039765305fc24c92370"
 },
