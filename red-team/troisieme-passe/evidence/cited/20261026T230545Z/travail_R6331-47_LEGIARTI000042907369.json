 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000042907369</ID>\n<ANCIEN_ID/>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/42/90/73/LEGIARTI000042907369.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>R6331-47</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>2020-12-31</DATE_DEBUT>\n<DATE_FIN>2022-01-01</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006072050\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code du travail\" debut=\"1973-01-03\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006072050\">Code du travail</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000018464861\">Partie réglementaire  </TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000018524328\">Sixième partie : La formation professionnelle tout au long de la vie </TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000018523325\">Livre III : La formation professionnelle continue </TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000018522965\">Titre III : Financement de la formation professionnelle continue </TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000018522963\">Chapitre Ier : Participation des employeurs au développement  de la formation professionnelle continue</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2012-12-10\" id=\"LEGISCTA000018522888\">Section 4 : Dispositions applicables à certaines catégories d'employeurs</TITRE_TM>\n<TITRE_TM debut=\"2012-12-10\" fin=\"2999-01-01\" id=\"LEGISCTA000026757095\">Section 4 : Dispositions applicables à certaines catégories d'employeurs et de travailleurs indépendants</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"2008-05-01\" fin=\"2999-01-01\" id=\"LEGISCTA000018522862\">Sous-section 2 : Travailleurs indépendants,  membres des professions libérales et professions non salariées</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2008-05-01\" etat=\"MODIFIE\" fin=\"2020-12-31\" id=\"LEGIARTI000018522860\" num=\"R6331-47\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2020-12-31\" etat=\"MODIFIE\" fin=\"2022-01-01\" id=\"LEGIARTI000042907369\" num=\"R6331-47\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2022-01-01\" etat=\"MODIFIE\" fin=\"2022-07-01\" id=\"LEGIARTI000044969960\" num=\"R6331-47\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2022-07-01\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000045987495\" num=\"R6331-47\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<p>La contribution prévue à l'article L. 6331-48 est due par les personnes non salariées, à l'exception de celles dont la rémunération ne peut être prise en compte pour la détermination du montant des salaires, entendu au sens du 1 de l'article 231 du code général des impôts, mentionnées au premier alinéa de l'article L. 6331-48 et à l'article L. 6331-53.\n<br/>Ces personnes ne peuvent bénéficier du droit à la formation professionnelle continue que si elles sont à jour du paiement de cette contribution.</p>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000042760113\" datesignatexte=\"2020-12-29\" id=\"LEGIARTI000042879668\" naturetexte=\"DECRET\" nortexte=\"MTRD2031610D\" num=\"1\" numtexte=\"2020-1739\" sens=\"cible\" typelien=\"MODIFIE\">Décret n°2020-1739 du 29 décembre 2020 - art. 1</LIEN>\n\n<LIEN cidtexte=\"LEGITEXT000006069577\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006308868\" naturetexte=\"CODE\" nortexte=\"\" num=\"231\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code général des impôts, CGI. - art. 231</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006075116\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000047725052\" naturetexte=\"CODE\" nortexte=\"\" num=\"R252-1\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de l'artisanat - art. R252-1 (VD)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006904325\" naturetexte=\"CODE\" nortexte=\"\" num=\"L6331-48\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code du travail - art. L6331-48</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006904330\" naturetexte=\"CODE\" nortexte=\"\" num=\"L6331-53\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code du travail - art. L6331-53</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006904331\" naturetexte=\"CODE\" nortexte=\"\" num=\"L6331-54\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">Code du travail - art. L6331-54</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000030801367\" naturetexte=\"CODE\" nortexte=\"\" num=\"R6332-64\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code du travail - art. R6332-64 (M)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000042907449\" naturetexte=\"CODE\" nortexte=\"\" num=\"R6332-72\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code du travail - art. R6332-72 (M)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000022850536\" naturetexte=\"CODE\" nortexte=\"\" num=\"R6332-74\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code du travail - art. R6332-74 (Ab)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006072050\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000018508629\" naturetexte=\"CODE\" nortexte=\"\" num=\"R953-1\" numtexte=\"\" sens=\"source\" typelie