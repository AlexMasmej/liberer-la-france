e=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2006-12-16\" etat=\"MODIFIE\" fin=\"2017-11-01\" id=\"LEGIARTI000006300850\" num=\"121 Z quinquies\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2017-11-01\" etat=\"MODIFIE\" fin=\"2018-05-31\" id=\"LEGIARTI000035838149\" num=\"121 Z quinquies\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2018-05-31\" etat=\"MODIFIE\" fin=\"2025-02-16\" id=\"LEGIARTI000036961903\" num=\"121 Z quinquies\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2025-02-16\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000051183437\" num=\"121 Z quinquies\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   Les personnes physiques qui résident habituellement dans la Principauté de Monaco, qu'elles soient ou non fiscalement domiciliées en France, sont tenues d'accomplir leurs obligations déclaratives en matière d'impôt sur le revenu au service des impôts de Menton.<br/>\n<br/>   Les déclarations d'impôt de solidarité sur la fortune ainsi que les déclarations de succession des personnes visées au premier alinéa sont déposées au service des impôts de Menton.<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"\" datesignatexte=\"\" id=\"\" naturetexte=\"\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"CODIFICATION\">Arrêté 2006-03-24</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000813882\" datesignatexte=\"2005-12-30\" id=\"LEGIARTI000006322702\" naturetexte=\"LOI\" nortexte=\"ECOX0500273L\" num=\"103\" numtexte=\"2005-1720\" sens=\"source\" typelien=\"MODIFICATION\">Loi n°2005-1720 du 30 décembre 2005 - art. 103 () JORF 31 décembre 2005</LIEN>\n<LIEN cidtexte=\"JORFTEXT000051170250\" datesignatexte=\"2025-01-30\" id=\"LEGIARTI000051180332\" naturetexte=\"ARRETE\" nortexte=\"ECOE2500290A\" num=\"1\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">A