" etat=\"MODIFIE\" fin=\"2005-01-01\" id=\"LEGIARTI000006312763\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2005-01-01\" etat=\"MODIFIE\" fin=\"2005-12-31\" id=\"LEGIARTI000006312764\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2006-01-01\" etat=\"MODIFIE\" fin=\"2007-01-01\" id=\"LEGIARTI000006312765\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2007-01-01\" etat=\"MODIFIE\" fin=\"2010-05-01\" id=\"LEGIARTI000006312766\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2010-05-01\" etat=\"MODIFIE\" fin=\"2010-05-01\" id=\"LEGIARTI000022178455\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2010-05-01\" etat=\"MODIFIE\" fin=\"2013-01-01\" id=\"LEGIARTI000022201898\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2013-01-01\" etat=\"MODIFIE\" fin=\"2014-01-01\" id=\"LEGIARTI000026947362\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2014-01-01\" etat=\"MODIFIE\" fin=\"2015-01-01\" id=\"LEGIARTI000028447661\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2015-01-01\" etat=\"MODIFIE\" fin=\"2017-01-01\" id=\"LEGIARTI000029355587\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2017-01-01\" etat=\"MODIFIE\" fin=\"2019-01-01\" id=\"LEGIARTI000033805495\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2019-01-01\" etat=\"MODIFIE\" fin=\"2019-06-08\" id=\"LEGIARTI000037988217\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2019-06-08\" etat=\"MODIFIE\" fin=\"2020-01-01\" id=\"LEGIARTI000038686414\" num=\"1668\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART deb