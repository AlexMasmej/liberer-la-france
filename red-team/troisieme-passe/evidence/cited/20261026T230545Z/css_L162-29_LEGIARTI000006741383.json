4-12-21\" fin=\"2017-01-01\" id=\"LEGISCTA000006186124\">Sous-section 4 : Dispositions diverses</TITRE_TM>\n<TITRE_TM debut=\"2017-01-01\" fin=\"2999-01-01\" id=\"LEGISCTA000031688088\">Sous-section 6 : Dispositions diverses</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1985-12-21\" etat=\"MODIFIE\" fin=\"2005-01-01\" id=\"LEGIARTI000006741382\" num=\"L162-29\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2005-01-01\" etat=\"MODIFIE\" fin=\"2017-01-14\" id=\"LEGIARTI000006741383\" num=\"L162-29\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2017-01-14\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000033865565\" num=\"L162-29\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   Les établissements publics de santé et les établissements privés admis à participer à l'exécution du service public hospitalier sont tenus de permettre aux organismes d'assurance maladie d'exercer leur contrôle en vertu de l'article L. 162-30 sur les assurés hospitalisés et sur l'activité des services dans les conditions définies par un décret en Conseil d'Etat qui fixe notamment la teneur, la périodicité et les délais de production des informations qui doivent être adressées à cette fin aux organismes d'assurance maladie. <br/>\n<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000699946\" datesignatexte=\"1977-09-26\" id=\"LEGIARTI000032078893\" naturetexte=\"ORDONNANCE\" nortexte=\"\" num=\"9\" numtexte=\"77-1102\" sens=\"cible\" typelien=\"CITATION\">Ordonnance n° 77-1102 du 26 septembre 1977 - art. 9 (M)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000866621\" datesignatexte=\"1985-12-17\" id=\"JORFTEXT000000866621\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"85-1353\" sens=\"source\" typelien=\"CODIFICATION\">Décret 85-1353 1985-12-17</LIEN>\n<