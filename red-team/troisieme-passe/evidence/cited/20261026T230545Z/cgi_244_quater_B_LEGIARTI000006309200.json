>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2014-05-30\" etat=\"MODIFIE\" fin=\"2014-12-22\" id=\"LEGIARTI000029041806\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2014-12-22\" etat=\"MODIFIE\" fin=\"2015-01-01\" id=\"LEGIARTI000029947171\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2015-01-01\" etat=\"MODIFIE\" fin=\"2015-06-06\" id=\"LEGIARTI000030023561\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2015-06-06\" etat=\"MODIFIE\" fin=\"2016-01-01\" id=\"LEGIARTI000030701341\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2016-01-01\" etat=\"MODIFIE\" fin=\"2017-01-01\" id=\"LEGIARTI000031779254\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2017-01-01\" etat=\"MODIFIE\" fin=\"2017-12-30\" id=\"LEGIARTI000033817567\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2017-12-30\" etat=\"MODIFIE\" fin=\"2018-01-01\" id=\"LEGIARTI000036363476\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2018-01-01\" etat=\"MODIFIE\" fin=\"2018-12-31\" id=\"LEGIARTI000036432071\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2018-12-31\" etat=\"MODIFIE\" fin=\"2019-12-30\" id=\"LEGIARTI000037988033\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2019-12-30\" etat=\"MODIFIE\" fin=\"2020-01-01\" id=\"LEGIARTI000041467205\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE_MORT_NE\">\n<LIEN_ART debut=\"2020-01-01\" etat=\"MODIFIE_MORT_NE\" fin=\"2019-12-31\" id=\"LEGIARTI000041520682\" num=\"244 quater B\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\