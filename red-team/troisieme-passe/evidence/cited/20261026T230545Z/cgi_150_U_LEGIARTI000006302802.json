\" id=\"LEGISCTA000006197219\">D : Dispositions particulières.</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1992-07-04\" etat=\"MODIFIE\" fin=\"1998-04-22\" id=\"LEGIARTI000006302801\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1998-04-22\" etat=\"MODIFIE\" fin=\"2000-03-31\" id=\"LEGIARTI000006302802\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"PERIME\">\n<LIEN_ART debut=\"2000-03-31\" etat=\"PERIME\" fin=\"2002-03-31\" id=\"LEGIARTI000006302803\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2003-12-31\" etat=\"MODIFIE\" fin=\"2004-12-31\" id=\"LEGIARTI000006302804\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2004-12-31\" etat=\"MODIFIE\" fin=\"2005-02-24\" id=\"LEGIARTI000006302805\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2005-01-01\" etat=\"MODIFIE\" fin=\"2005-07-27\" id=\"LEGIARTI000006302806\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2005-07-27\" etat=\"MODIFIE\" fin=\"2005-12-31\" id=\"LEGIARTI000006302807\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2005-12-31\" etat=\"MODIFIE\" fin=\"2006-07-16\" id=\"LEGIARTI000006302808\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2006-07-16\" etat=\"MODIFIE\" fin=\"2007-03-06\" id=\"LEGIARTI000006302809\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2007-03-06\" etat=\"MODIFIE\" fin=\"2007-12-28\" id=\"LEGIARTI000006302810\" num=\"150 U\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2007-12-28\" etat=\"MODIFIE\" fin=\"2009-03-28\" id=\"LEGIARTI000017923851\" num=\"150 U\" origine