\n</VERSION>\n<VERSION etat=\"VIGUEUR_DIFF\">\n<LIEN_ART debut=\"2027-01-01\" etat=\"VIGUEUR_DIFF\" fin=\"2999-01-01\" id=\"LEGIARTI000053187629\" num=\"1042\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>     Sous réserve des dispositions de l'article 257-7°, les acquisitions faites à l'amiable et à titre onéreux par les départements, communes ou syndicats de communes et par les établissements publics, départementaux ou communaux, ne donnent lieu à aucune perception au profit du Trésor lorsqu'elles sont destinées à l'enseignement public, à l'assistance ou à l'hygiène sociales, ainsi qu'aux travaux d'urbanisme et de construction, et qu'un arrêté préfectoral a déclaré, en cas d'urgence, l'utilité publique de ces acquisitions sans qu'il soit besoin de procéder aux formalités d'enquête.<br/>\n<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"\" datesignatexte=\"\" id=\"\" naturetexte=\"\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">CGI 257 7°</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006069577\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000022336396\" naturetexte=\"CODE\" nortexte=\"\" num=\"1929\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code général des impôts, CGI. - art. 1929 (Ab)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006069577\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000051149498\" naturetexte=\"CODE\" nortexte=\"\" num=\"793\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code général des impôts, CGI. - art. 793 (V)</LIEN>\n<LIEN cidtexte=\"\" datesignatexte=\"\" id=\"\" naturetexte=\"\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"HISTO\">EDITION 1979-07-01</LIEN>\n</LIENS>\n</ARTICLE>\n",
