 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000006313359</ID>\n<ANCIEN_ID>FAAACGIXXXX1965AGXXXXXBA</ANCIEN_ID>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/06/31/33/LEGIARTI000006313359.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>1965 FA</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>1980-12-31</DATE_DEBUT>\n<DATE_FIN>1986-12-31</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006069577\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code général des impôts, CGI.\" debut=\"1952-02-14\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006069577\">Code général des impôts</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1972-08-30\" fin=\"2006-01-01\" id=\"LEGISCTA000006084262\">RECOUVREMENT DE L'IMPOT</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1979-07-01\" fin=\"1986-12-31\" id=\"LEGISCTA000006114513\">DEGREVEMENTS ET RESTITUTIONS D'IMPOTS</TITRE_TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1980-12-31\" etat=\"MODIFIE\" fin=\"1986-12-31\" id=\"LEGIARTI000006313359\" num=\"1965 FA\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"ABROGE_DIFF\">\n<LIEN_ART debut=\"1986-12-31\" etat=\"ABROGE_DIFF\" fin=\"2027-01-01\" id=\"LEGIARTI000006313360\" num=\"1965 FA\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR_DIFF\">\n<LIEN_ART debut=\"2027-01-01\" etat=\"VIGUEUR_DIFF\" fin=\"2999-01-01\" id=\"LEGIARTI000053189085\" num=\"1965 FA\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   Lorsqu'une personne a indûment acquitté des droits indirects régis par le présent code, elle ne peut en obtenir le remboursement, sauf en cas d'erreur matérielle, que si elle justifie que ces droits n'ont pas été répercutés sur l'acheteur.<br/>\n<br/>   Cette disposition est applicable aux réclamations présentées dans les conditions prévues à l'article R190-1 du livre des procédures fiscales, même avant le 1er janvier 1981.<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"\" datesignatexte=\"\" id=\"\" naturetexte=\"\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"CITATION\">CGI R190-1</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000339460\" datesignatexte=\"1980-12-30\" id=\"LEGIARTI000006273367\" naturetexte=\"LOI\" nortexte=\"\" num=\"13\" numtexte=\"80-1094\" sens=\"source\" typelien=\"CREATION\">Loi n°80-1094 du 30 décembre 1980 - art. 13 (P) JORF 31 DECEMBRE 1980</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000701296\" datesignatexte=\"1981-09-15\" id=\"JORFTEXT000000701296\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"81-866\" sens=\"source\" typelien=\"CODIFICATION\">Décret 81-866 1981-09-15</LIEN>\n</LIENS>\n</ARTICLE>\n",
