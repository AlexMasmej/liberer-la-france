 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000006742231</ID>\n<ANCIEN_ID>SSAXXXXXXXX1X281L03AXXAD</ANCIEN_ID>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/06/74/22/LEGIARTI000006742231.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>L281-3</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>2004-08-17</DATE_DEBUT>\n<DATE_FIN>2010-02-26</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006073189\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code de la sécurité sociale.\" debut=\"1958-10-16\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006073189\">Code de la sécurité sociale</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1985-12-21\" fin=\"2999-01-01\" id=\"LEGISCTA000006106050\">Partie législative</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1985-12-21\" fin=\"2999-01-01\" id=\"LEGISCTA000006126888\">Livre II : Organisation du régime général, action de prévention, action sanitaire et sociale des caisses</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1988-01-06\" fin=\"2999-01-01\" id=\"LEGISCTA000006141713\">Titre VIII : Contrôle de l'administration - Dispositions d'application du livre 2</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1988-01-06\" fin=\"2999-01-01\" id=\"LEGISCTA000006156321\">Chapitre 1er : Contrôle sur les organismes locaux et régionaux</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1985-12-21\" etat=\"MODIFIE\" fin=\"1988-01-06\" id=\"LEGIARTI000006742228\" num=\"L281-3\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1988-01-06\" etat=\"MODIFIE\" fin=\"1993-01-30\" id=\"LEGIARTI000006742229\" num=\"L281-3\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1993-01-30\" etat=\"MODIFIE\" fin=\"2004-08-17\" id=\"LEGIARTI000006742230\" num=\"L281-3\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2004-08-17\" etat=\"MODIFIE\" fin=\"2010-02-26\" id=\"LEGIARTI000006742231\" num=\"L281-3\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2010-02-26\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000021941700\" num=\"L281-3\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   L'autorité compétente de l'Etat peut : <br/>\n<br/>   1°) en cas d'irrégularités graves, de mauvaise gestion ou de carence du conseil ou du conseil d'administration d'une caisse d'allocations familiales ou d'une caisse primaire ou régionale d'assurance maladie ou d'une union de recouvrement des cotisations de sécurité sociale et d'allocations familiales, suspendre ou dissoudre ce conseil et nommer un administrateur provisoire ; <br/>\n<br/>   2°) si les irrégularités ou la mauvaise gestion sont imputables à un ou plusieurs membres du conseil ou du conseil d'administration, révoquer ceux-ci, après avis dudit conseil. <br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000000866621\" datesignatexte=\"1985-12-17\" id=\"JORFTEXT000000866621\" naturetexte=\"DECRET\" nortexte=\"\" num=\"\" numtexte=\"85-1353\" sens=\"source\" typelien=\"CODIFICATION\">Décret 85-1353 1985-12-17</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000742093\" datesignatexte=\"1996-04-24\" id=\"LEGIARTI000006759811\" naturetexte=\"ORDONNANCE\" nortexte=\"TASX9600032R\" num=\"14\" numtexte=\"96-344\" sens=\"cible\" typelien=\"CITATION\">Rapport - art. 14 (V)</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000625158\" datesignatexte=\"2004-08-13\" id=\"LEGIARTI000006759001\" naturetexte=\"LOI\" nortexte=\"SANX0400122L\" num=\"69\" numtexte=\"2004-810\" sens=\"source\" typelien=\"MODIFICATION\">Loi n°2004-810 du 13 août 2004 - art. 69 () JORF 17 août 2004</LIEN>\n<LIEN cidtexte=\"J