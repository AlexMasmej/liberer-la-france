-30\" fin=\"2016-08-10\" id=\"LEGISCTA000031727993\">Sous-section 2 : Congé de proche aidant.</TITRE_TM>\n<TITRE_TM debut=\"2016-08-10\" fin=\"2999-01-01\" id=\"LEGISCTA000033022155\">Sous-section 2 : Congé de participation aux instances d'emploi et de formation professionnelle ou à un jury d'examen</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"TRANSFERE\">\n<LIEN_ART debut=\"2008-05-01\" etat=\"TRANSFERE\" fin=\"2008-05-01\" id=\"LEGIARTI000006902696\" num=\"L3142-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2008-05-01\" etat=\"MODIFIE\" fin=\"2015-12-30\" id=\"LEGIARTI000018765752\" num=\"L3142-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2015-12-30\" etat=\"MODIFIE\" fin=\"2016-08-10\" id=\"LEGIARTI000031727987\" num=\"L3142-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2016-08-10\" etat=\"MODIFIE\" fin=\"2019-08-23\" id=\"LEGIARTI000033022121\" num=\"L3142-28\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR\">\n<LIEN_ART debut=\"2019-08-23\" etat=\"VIGUEUR\" fin=\"2999-01-01\" id=\"LEGIARTI000038952020\" num=\"L3142-28\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU>\n<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>\n</CONTENU>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<p>La durée du congé de soutien familial est prise en compte pour la détermination des avantages liés à l'ancienneté. <br/>\n<br/> Le salarié conserve le bénéfice de tous les avantages qu'il avait acquis avant le début du congé. </p>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"JORFTEXT000017942034\" datesignatexte=\"2008-01-21\" id=\"LEGIARTI000017961478\" naturetexte=\"LOI\" nortexte=\"MTSX0700051L\" num=\"3\" numtexte=\"2008-67\" sens=\"source\" typelien=\"MODIFICATION\">LOI n°2008-67 du 21 janvier 2008 - art. 3</LIEN>\n\n\n\n\n\n\n<LIEN cidtexte=\"JORFTEXT000038829574\" datesignate