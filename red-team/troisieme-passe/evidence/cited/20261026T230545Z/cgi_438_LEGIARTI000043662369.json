Tarifs</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1950-04-30\" etat=\"MODIFIE\" fin=\"1950-10-10\" id=\"LEGIARTI000048274486\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1950-10-10\" etat=\"MODIFIE\" fin=\"1979-07-01\" id=\"LEGIARTI000049326753\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1979-07-01\" etat=\"MODIFIE\" fin=\"1981-01-01\" id=\"LEGIARTI000006309897\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1981-01-01\" etat=\"MODIFIE\" fin=\"1982-01-01\" id=\"LEGIARTI000006309898\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1982-01-01\" etat=\"MODIFIE\" fin=\"1986-04-01\" id=\"LEGIARTI000006309899\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1986-04-01\" etat=\"MODIFIE\" fin=\"1993-02-01\" id=\"LEGIARTI000006309900\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1993-02-01\" etat=\"MODIFIE\" fin=\"1997-04-11\" id=\"LEGIARTI000006309901\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1997-04-11\" etat=\"MODIFIE\" fin=\"2002-01-01\" id=\"LEGIARTI000006309902\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2002-03-31\" etat=\"MODIFIE\" fin=\"2008-12-19\" id=\"LEGIARTI000006309903\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2008-12-19\" etat=\"MODIFIE\" fin=\"2009-04-10\" id=\"LEGIARTI000019950361\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2009-04-10\" etat=\"MODIFIE\" fin=\"2010-05-01\" id=\"LEGIARTI000020549050\" num=\"438\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"2010-