 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000006309797</ID>\n<ANCIEN_ID>FAAACGIXXXX0363AAXXXXXAB</ANCIEN_ID>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/06/30/97/LEGIARTI000006309797.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>363</NUM>\n\n<ETAT>MODIFIE</ETAT>\n\n<DATE_DEBUT>1985-09-01</DATE_DEBUT>\n<DATE_FIN>1999-03-31</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006069577\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code général des impôts, CGI.\" debut=\"1952-02-14\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006069577\">Code général des impôts</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1952-02-14\" fin=\"2999-01-01\" id=\"LEGISCTA000006084232\">Livre premier : Assiette et liquidation de l'impôt</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1952-02-14\" fin=\"2999-01-01\" id=\"LEGISCTA000006114494\">Première Partie : Impôts d'État</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1970-07-05\" fin=\"2027-01-01\" id=\"LEGISCTA000006133849\">Titre III : Contributions indirectes et taxes diverses</TITRE_TM>\n<TITRE_TM debut=\"2027-01-01\" fin=\"2999-01-01\" id=\"LEGISCTA000053187720\">Titre III : Taxes sur les alcools et tabacs autres que l'accise</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1970-07-05\" fin=\"2999-01-01\" id=\"LEGISCTA000006147058\">Chapitre premier : Boissons</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1979-07-01\" fin=\"2999-01-01\" id=\"LEGISCTA000006162613\">Section I : Alcools</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1985-09-01\" fin=\"1999-03-31\" id=\"LEGISCTA000006179908\">B ter : Dispositions communes aux régimes de l'alcool de betterave et du rhum.</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1950-04-30\" etat=\"MODIFIE\" fin=\"1979-07-01\" id=\"LEGIARTI000048234894\" num=\"363\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"PERIME\">\n<LIEN_ART debut=\"1979-07-01\" etat=\"PERIME\" fin=\"1985-07-12\" id=\"LEGIARTI000006309796\" num=\"363\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1985-09-01\" etat=\"MODIFIE\" fin=\"1999-03-31\" id=\"LEGIARTI000006309797\" num=\"363\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"MODIFIE\">\n<LIEN_ART debut=\"1999-03-31\" etat=\"MODIFIE\" fin=\"2026-07-29\" id=\"LEGIARTI000006309798\" num=\"363\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"ABROGE_DIFF\">\n<LIEN_ART debut=\"2026-07-29\" etat=\"ABROGE_DIFF\" fin=\"2029-01-01\" id=\"LEGIARTI000054591224\" num=\"363\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR_DIFF\">\n<LIEN_ART debut=\"2029-01-01\" etat=\"VIGUEUR_DIFF\" fin=\"2999-01-01\" id=\"LEGIARTI000054591752\" num=\"363\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU/>\n</NOTA>\n<BLOC_TEXTUEL>\n<CONTENU>\n<br/>   Les infractions aux prescriptions des textes législatifs ou réglementaires relatifs aux régimes de l'alcool de betterave et du rhum sont constatées et poursuivies comme en matière de contributions indirectes.<br/>\n<br/>\n</CONTENU>\n</BLOC_TEXTUEL>\n<LIENS>\n<LIEN cidtexte=\"\" datesignatexte=\"\" id=\"\" naturetexte=\"\" nortexte=\"\" num=\"\" numtexte=\"\" sens=\"source\" typelien=\"SPEC_APPLI\">Dans l'édition 1997, les mots \"monopoles fiscaux\" disparaissent de l'intitulé du Titre III et de celui du chapitre IV</LIEN>\n<LIEN cidtexte=\"JORFTEXT000000693456\" datesignatexte=\"1985-07-11\" id=\"LEGIARTI000006274626\" naturetexte=\"LOI\" nortexte=\"\" num=\"19\" numtexte=\"85-695\" sens=\"source\" typelien=\"CREATION\">Loi n°85-695 du 11 juillet 1985 - art. 19 () JORF 12 juillet 1985, rectificatif JORF 13 juillet 1985, entrée en vigueur le 1er septembre 1985</LIEN>\n</LIENS>\n</ARTICLE>\n",
