 "document_xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ARTICLE>\n<META>\n<META_COMMUN>\n<ID>LEGIARTI000054466960</ID>\n<ANCIEN_ID/>\n<ORIGINE>LEGI</ORIGINE>\n<URL>article/LEGI/ARTI/00/00/54/46/69/LEGIARTI000054466960.xml</URL>\n<NATURE>Article</NATURE>\n</META_COMMUN>\n<META_SPEC>\n<META_ARTICLE>\n\n<NUM>L713-19</NUM>\n\n<ETAT>VIGUEUR_DIFF</ETAT>\n\n<DATE_DEBUT>2028-01-01</DATE_DEBUT>\n<DATE_FIN>2999-01-01</DATE_FIN>\n\n\n\n<TYPE>AUTONOME</TYPE>\n</META_ARTICLE>\n</META_SPEC>\n</META>\n<CONTEXTE>\n<TEXTE autorite=\"\" cid=\"LEGITEXT000006073189\" date_publi=\"2999-01-01\" date_signature=\"2999-01-01\" ministere=\"\" nature=\"CODE\" nor=\"\" num=\"\" num_parution_jo=\"\">\n<TITRE_TXT c_titre_court=\"Code de la sécurité sociale.\" debut=\"1958-10-16\" fin=\"2999-01-01\" id_txt=\"LEGITEXT000006073189\">Code de la sécurité sociale</TITRE_TXT>\n<TM>\n<TITRE_TM debut=\"1985-12-21\" fin=\"2999-01-01\" id=\"LEGISCTA000006106050\">Partie législative</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1985-12-21\" fin=\"2999-01-01\" id=\"LEGISCTA000006126904\">Livre VII : Régimes divers - Dispositions diverses</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1985-12-21\" fin=\"2999-01-01\" id=\"LEGISCTA000006141679\">Titre I : Régimes spéciaux</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1985-12-21\" fin=\"2999-01-01\" id=\"LEGISCTA000006156233\">Chapitre 3 : Régime des militaires</TITRE_TM>\n<TM>\n<TITRE_TM debut=\"1985-12-21\" fin=\"2999-01-01\" id=\"LEGISCTA000006172769\">Section 4 : Caisse nationale militaire de sécurité sociale</TITRE_TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TM>\n</TEXTE>\n</CONTEXTE>\n\n<VERSIONS>\n<VERSION etat=\"ABROGE_DIFF\">\n<LIEN_ART debut=\"1985-12-21\" etat=\"ABROGE_DIFF\" fin=\"2028-01-01\" id=\"LEGIARTI000006744037\" num=\"L713-19\" origine=\"LEGI\"/>\n</VERSION>\n<VERSION etat=\"VIGUEUR_DIFF\">\n<LIEN_ART debut=\"2028-01-01\" etat=\"VIGUEUR_DIFF\" fin=\"2999-01-01\" id=\"LEGIARTI000054466960\" num=\"L713-19\" origine=\"LEGI\"/>\n</VERSION>\n</VERSIONS>\n<NOTA>\n<CONTENU>\n<p>Co