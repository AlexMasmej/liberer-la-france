)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006073189\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006746644\" naturetexte=\"CODE\" nortexte=\"\" num=\"R162-36\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de la sécurité sociale. - art. R162-36 (Ab)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006073189\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000022896539\" naturetexte=\"CODE\" nortexte=\"\" num=\"R162-41-3\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de la sécurité sociale. - art. R162-41-3 (Ab)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006073189\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000006746664\" naturetexte=\"CODE\" nortexte=\"\" num=\"R162-42\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de la sécurité sociale. - art. R162-42 (M)</LIEN>\n<LIEN cidtexte=\"LEGITEXT000006073189\" datesignatexte=\"2999-01-01\" id=\"LEGIARTI000053285527\" naturetexte=\"CODE\" nortexte=\"\" num=\"R174-34\" numtexte=\"\" sens=\"cible\" typelien=\"CITATION\">Code de la sécurité sociale. - art. R174-34 (VD)</LIEN>\n</LIENS>\n</ARTICLE>\n",
